---
/**
 * Tugu Keris Siginjai Guide · shell
 * Arah desain: nuansa malam Kota Jambi, emas pusaka, garis keris, dan dokumentasi perjalanan yang tenang.
 */
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "id" | "en";
}

const { title, description, lang = "id" } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL("/images/tugu-keris-siginjai-night.jpg", Astro.site).href : undefined;

// Pasangan bahasa untuk hreflang. Kunci = path halaman ini, nilai = pasangannya.
const langPairs: Record<string, string> = {
  "/": "/en/",
  "/en/": "/",
  "/kebijakan-privasi/": "/en/privacy-policy/",
  "/en/privacy-policy/": "/kebijakan-privasi/",
  "/syarat-layanan/": "/en/terms-of-service/",
  "/en/terms-of-service/": "/syarat-layanan/",
  "/pengaturan-cookie/": "/en/cookie-settings/",
  "/en/cookie-settings/": "/pengaturan-cookie/",
};
const absHref = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const pair = langPairs[Astro.url.pathname];
const idPath = pair ? (Astro.url.pathname.startsWith("/en/") ? pair : Astro.url.pathname) : Astro.url.pathname;
const enPath = pair ? (Astro.url.pathname.startsWith("/en/") ? Astro.url.pathname : pair) : "/en/";
const hreflangId = absHref(idPath);
const hreflangEn = absHref(enPath);
const hreflangDefault = absHref("/");
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071821" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <>
      <link rel="alternate" hreflang="id" href={hreflangId} />
      <link rel="alternate" hreflang="en" href={hreflangEn} />
      <link rel="alternate" hreflang="x-default" href={hreflangDefault} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/icons/keris-mark.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
