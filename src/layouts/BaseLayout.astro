---
/**
 * Tugu Keris Siginjai Guide · shell
 * Arah desain: nuansa malam Kota Jambi, emas pusaka, garis keris, dan dokumentasi perjalanan yang tenang.
 */
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "id" | "en";
  noindex?: boolean;
}

const { title, description, lang = "id", noindex = false } = Astro.props;
const canonical = !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL("/images/tugu-keris-siginjai-night.jpg", Astro.site).href : undefined;

// Pasangan bahasa untuk hreflang halaman yang slug-nya TIDAK mencerminkan (beranda & halaman legal).
// Topik panjang-ekor menggunakan slug yang sama di id/en, sehingga ditangani generik di bawah.
const langPairs: Record<string, { id: string; en: string }> = {
  "/": { id: "/", en: "/en/" },
  "/en/": { id: "/", en: "/en/" },
  "/kebijakan-privasi/": { id: "/kebijakan-privasi/", en: "/en/privacy-policy/" },
  "/en/privacy-policy/": { id: "/kebijakan-privasi/", en: "/en/privacy-policy/" },
  "/syarat-layanan/": { id: "/syarat-layanan/", en: "/en/terms-of-service/" },
  "/en/terms-of-service/": { id: "/syarat-layanan/", en: "/en/terms-of-service/" },
  "/pengaturan-cookie/": { id: "/pengaturan-cookie/", en: "/en/cookie-settings/" },
  "/en/cookie-settings/": { id: "/pengaturan-cookie/", en: "/en/cookie-settings/" },
};
const absHref = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const explicit = langPairs[Astro.url.pathname];
const isEn = Astro.url.pathname.startsWith("/en/");
const idPath = explicit ? explicit.id : (isEn ? (Astro.url.pathname.slice(3) || "/") : Astro.url.pathname);
const enPath = explicit ? explicit.en : (isEn ? Astro.url.pathname : "/en" + (Astro.url.pathname === "/" ? "" : Astro.url.pathname));
const hreflangId = absHref(idPath);
const hreflangEn = absHref(enPath);
const hreflangDefault = absHref(idPath);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071821" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <>
      <link rel="alternate" hreflang="id" href={hreflangId} />
      <link rel="alternate" hreflang="en" href={hreflangEn} />
      <link rel="alternate" hreflang="x-default" href={hreflangDefault} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/icons/keris-mark.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
