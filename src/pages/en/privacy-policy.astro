---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "Privacy Policy — Tugu Keris Siginjai Guide";
const description = "Privacy policy for the independent visitor guide to Tugu Keris Siginjai, Jambi City.";
---
<BaseLayout {title} {description} lang="en">
  <a class="skip-link" href="#isi">Skip to content</a>
  <header class="legal-header">
    <a class="brand" href="/en/"><img src="/icons/keris-mark.svg" width="40" height="40" alt="" /><span><strong>Tugu Keris</strong><small>Jambi City guide</small></span></a>
    <div class="language-switch" aria-label="Choose language"><a href="/kebijakan-privasi/" lang="id">ID</a><span aria-hidden="true">/</span><a href="/en/privacy-policy/" lang="en" aria-current="page">EN</a></div>
  </header>

  <main id="isi">
    <section class="legal-hero"><div class="wrap">
      <p class="eyebrow"><span class="eyebrow-dot"></span> LEGAL · PRIVACY POLICY</p>
      <h1>Privacy, only <em>as needed.</em></h1>
      <p class="legal-lead">Last updated: August 2026. We collect only the minimum data needed to run the site, and we never sell your data.</p>
    </div></section>

    <section class="legal-body section wrap">
      <h2>Overview</h2>
      <p>We collect only the minimum data needed to operate the site, including technical browsing data, cookies, and information you voluntarily provide where a contact method is available.</p>

      <h2>Data we collect</h2>
      <ul>
        <li>Technical data when you open a page: anonymised IP address, device and browser type, and pages visited.</li>
        <li>Your cookie consent preference, stored on your device.</li>
        <li>Information you voluntarily submit, where a contact method is provided.</li>
      </ul>

      <h2>How data is used</h2>
      <p>Data is used to improve content, understand aggregate usage patterns, respond to requests, and meet legal obligations. We do not sell, rent, or trade your data to any third party.</p>

      <h2>Third-party services</h2>
      <p>Google Maps and Google Analytics may apply as third-party services under their respective privacy policies. When you open the map or agree to analytics, your data is managed by those providers under their terms.</p>

      <h2>Cookies</h2>
      <p>Essential storage keeps your consent preference. Analytics cookies are optional and load Google Analytics only after you agree. You can change your choice at any time on the <a class="source-link" href="/en/cookie-settings/">Cookie Settings</a> page.</p>

      <h2>Your rights</h2>
      <p>You may request access, correction, deletion, object to processing, or contact the relevant data-protection authority in accordance with applicable law.</p>

      <h2>Changes to this policy</h2>
      <p>This policy may be updated from time to time. Material changes are reflected in the revision date shown on this page.</p>

      <h2>Contact</h2>
      <p>For privacy-related questions, reach us through the channels available on this site, or contact the data-protection authority in your region.</p>

      <a class="legal-back" href="/en/">← Back to home</a>
    </section>
  </main>

  <footer class="site-footer"><div class="wrap footer-grid"><div class="footer-brand"><img src="/icons/keris-mark.svg" width="40" height="40" alt="" /><p><b>Tugu Keris Siginjai</b><span>Independent Jambi City guide</span></p></div><div class="footer-note"><p>This website is an independent, non-profit visitor-information project. It is not affiliated with any government body, site operator, or official organisation.</p><p>Information refers to public material from Jambi City Government, the Jambi City Tourism and Culture Office, and the Indonesia tourism portal; it does not contain commercial recommendations.</p></div><div class="footer-links"><a href="/en/privacy-policy/">Privacy Policy</a><a href="/en/terms-of-service/">Terms of Service</a><a href="/en/cookie-settings/">Cookie Settings</a></div><div class="footer-bottom"><span>© 2026 Tugu Keris Siginjai Guide. Original content is protected.</span><span>Photographs remain the copyright of their respective photographers.</span></div></div></footer>
</BaseLayout>
