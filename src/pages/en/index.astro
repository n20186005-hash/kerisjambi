---
/**
 * Tugu Keris Siginjai Guide · English route
 * Design direction: Jambi after dark, heirloom gold, keris lines, and calm visitor-facing documentation.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Tugu Keris Siginjai — Independent Jambi City Guide";
const description = "An independent guide to the story, access, facilities, and visitor planning for Tugu Keris Siginjai in Jambi City, Indonesia.";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const attractionSchema = {
  "@context": "https://schema.org", "@type": ["TouristAttraction", "LocalBusiness"], name: "Tugu Keris Siginjai", alternateName: "Monument of Keris Siginjai Jambi", description,
  image: canonical ? new URL("/images/tugu-keris-siginjai-night.jpg", Astro.site).href : "/images/tugu-keris-siginjai-night.jpg",
  address: { "@type": "PostalAddress", streetAddress: "9J95+Q4F, Paal Lima, Kecamatan Kota Baru", addressLocality: "Jambi City", addressRegion: "Jambi", postalCode: "36129", addressCountry: "ID" },
  geo: { "@type": "GeoCoordinates", latitude: -1.6305741540278058, longitude: 103.6067082705946 },
  openingHours: "Open-air space; please check local event arrangements before visiting.",
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.6", bestRating: "5", ratingExplanation: "A third-party map-service score that may change." },
  isAccessibleForFree: true, sameAs: ["https://www.indonesia.travel/us/en/destination/sumatra/jambi/tugu-keris-siginjai-jambi"]
};
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: [
  { "@type": "Question", name: "Is there an admission ticket for Tugu Keris Siginjai?", acceptedAnswer: { "@type": "Answer", text: "The monument is in a public open-air space and is generally viewed without a routine ticket booth. Visitors should still check for local event arrangements or area restrictions before travelling." } },
  { "@type": "Question", name: "When is a good time to visit?", acceptedAnswer: { "@type": "Answer", text: "Morning and the period before or after sunset are usually more comfortable for walking and photographs. Night lighting is part of the landmark experience, while weather and city activity can affect conditions." } },
  { "@type": "Question", name: "How do I get there from Sultan Thaha Airport?", acceptedAnswer: { "@type": "Answer", text: "Use a rental vehicle, airport taxi, ride-hailing service, or check active local bus routes and stops. Confirm current routes and schedules with local providers before relying on public transport." } },
  { "@type": "Question", name: "Are parking and toilets available?", acceptedAnswer: { "@type": "Answer", text: "Parking, toilets, and traffic arrangements can change with public events and activity around the administrative district. Allow extra time and follow signs or on-site staff directions." } }
] };
---
<BaseLayout {title} {description} lang="en">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <a class="skip-link" href="#content">Skip to main content</a>
  <header class="site-header" id="home">
    <a class="brand" href="#home" aria-label="Return to the top of the guide"><img src="/icons/keris-mark.svg" width="44" height="44" alt="" /><span><strong>Tugu Keris</strong><small>Jambi City guide</small></span></a>
    <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-button><span></span><span></span></button>
    <nav class="main-nav" aria-label="Primary navigation" data-main-nav><a href="#meaning">Story</a><a href="#visit">Visit</a><a href="#access">Access</a><a href="#map">Map</a><a href="#faq">FAQ</a></nav>
    <div class="language-switch" aria-label="Select language"><a href="/" lang="id">ID</a><span aria-hidden="true">/</span><a href="/en/" lang="en" aria-current="page">EN</a></div>
  </header>

  <main id="content">
    <section class="hero" aria-labelledby="main-title"><div class="hero-photo" aria-hidden="true"><img src="/images/tugu-keris-siginjai-night.jpg" alt="" /></div><div class="hero-overlay"></div><div class="hero-content wrap"><p class="eyebrow"><span class="eyebrow-dot"></span> JAMBI CITY · INDONESIA</p><h1 id="main-title">Tugu<br /><em>Keris Siginjai</em></h1><p class="hero-intro">A civic landmark carrying the memory of Jambi’s heirloom—first seen from a distance, then understood through form, light, and the story it represents.</p><div class="hero-actions"><a class="button button-gold" href="#visit">Plan your visit <span>↘</span></a><a class="text-link light" href="#meaning">Read the monument story <span>↓</span></a></div></div><div class="hero-meta wrap"><span>01 / LANDMARK</span><span class="hero-line"></span><span>-1.630574, 103.606708</span></div></section>

    <section class="intro section wrap" aria-labelledby="overview-title"><div class="section-label">01 / OVERVIEW</div><div class="intro-grid"><h2 id="overview-title">More than a<br /><em>monument at a city junction.</em></h2><div class="intro-copy"><p>Tugu Keris Siginjai stands in Kota Baru, near Jambi City’s administrative district. Its form draws on Keris Siginjai, an heirloom associated in museum and local-government narratives with Jambi’s dignity and heroism.</p><p>The open space around it changes with the city’s rhythm: a point of orientation, a photographic backdrop, a meeting point, and at times part of a public programme. This guide helps you read the place while planning a measured visit.</p><a href="https://www.indonesia.travel/us/en/destination/sumatra/jambi/tugu-keris-siginjai-jambi" class="source-link" target="_blank" rel="noreferrer">Open Indonesia tourism reference <span>↗</span></a></div></div><div class="facts-grid" role="list" aria-label="At-a-glance facts"><article role="listitem"><span class="fact-icon">⌁</span><p class="fact-label">IDENTITY</p><h3>A Jambi City icon</h3><p>A keris-shaped landmark in the Kota Baru district.</p></article><article role="listitem"><span class="fact-icon">↟</span><p class="fact-label">SCALE</p><h3>Approx. 28 metres</h3><p>A figure often used in public introductions; not a measurement by this site.</p></article><article role="listitem"><span class="fact-icon">◎</span><p class="fact-label">MAP RATING</p><h3>4.6 / 5</h3><p>A third-party map-service score that may change.</p></article><article role="listitem"><span class="fact-icon">◌</span><p class="fact-label">COST</p><h3>Open-air space</h3><p>No routine ticket booth is apparent; check event arrangements first.</p></article></div></section>

    <section class="meaning-section" id="meaning" aria-labelledby="meaning-title"><div class="wrap meaning-layout"><div class="meaning-visual"><div class="keris-line keris-line-1"></div><div class="keris-line keris-line-2"></div><div class="keris-line keris-line-3"></div><img src="/icons/keris-mark.svg" alt="A simplified keris line symbol" /><p>SI GINJAI / HEIRLOOM</p></div><div class="meaning-copy"><p class="section-label gold">02 / MEANING IN FORM</p><h2 id="meaning-title">A keris as the<br /><em>language of dignity.</em></h2><p>In the National Museum of Indonesia’s collection record, Keris Si Ginjei is described as a Jambi Kingdom heirloom connected with royal authority. Jambi City’s own explanation of its emblem also links Keris Siginjai to the dignity and heroism of Jambi’s former rulers.</p><p>The monument is not the heirloom itself. It is the city-scale translation of cultural memory into public space—a way to recognise Jambi as you enter Kota Baru.</p><div class="citation-box"><span>PRIMARY REFERENCES</span><a href="https://museumnasional.iheritage-virtual.id/collection/detail/75" target="_blank" rel="noreferrer">National Museum of Indonesia <b>↗</b></a><a href="https://jambikota.go.id/tentang/profil/arti_lambang" target="_blank" rel="noreferrer">Jambi City Government <b>↗</b></a></div></div></div></section>

    <section class="visit-section section wrap" id="visit" aria-labelledby="visit-title"><div class="section-head"><div><p class="section-label">03 / VISIT</p><h2 id="visit-title">Arrive with<br /><em>the right expectation.</em></h2></div><p class="section-lead">The monument works best as a short stop connected with another Jambi City plan. It is an open urban space rather than a museum with a fixed visitor route.</p></div><div class="visit-grid"><article class="visit-card dark-card"><p class="card-number">A / TIMING</p><h3>Morning or near sunset</h3><p>For walking and photographs, consider the morning before the heat builds or late afternoon into the evening, when the monument’s lighting becomes more apparent. Match your plans to weather and local activity.</p><div class="visit-tag">WEATHER & CROWDING MAY CHANGE</div></article><article class="visit-card"><p class="card-number">B / DURATION</p><h3>30–60 minutes</h3><p>This allows time to see the monument, take photographs, read a brief overview, and observe the district. Add time if you arrive during a public event or combine the stop with another destination.</p><div class="visit-tag">A SHORT URBAN STOP</div></article><article class="visit-card photo-card"><img src="/images/jambi-civic-context.jpg" alt="A civic building in Jambi City, showing the context of the administrative district" /><div><p class="card-number">C / DISTRICT</p><h3>Kota Baru</h3><p>The monument sits in an administrative setting; be aware of access, events, and local vehicle flow.</p></div></article></div></section>

    <section class="access-section" id="access" aria-labelledby="access-title"><div class="wrap"><div class="section-head on-dark"><div><p class="section-label gold">04 / ACCESS & ORIENTATION</p><h2 id="access-title">Move through the city,<br /><em>not toward a ticket desk.</em></h2></div><p class="section-lead">Use “Monument of Keris Siginjai Jambi” or the Paal Lima, Kota Baru address as your destination. Travel times, routes, and road capacity can change.</p></div><div class="transport-grid"><article><span class="transport-mark">01</span><h3>From Sultan Thaha Airport</h3><p>The most direct options are an airport taxi, a rental vehicle, or a ride-hailing service. City buses have served the airport area; confirm active routes and schedules before relying on them.</p></article><article><span class="transport-mark">02</span><h3>Bus & local transport</h3><p>Choose an active stop or route toward Kota Baru, then continue on foot or by short-distance transport. Check route information on the day you travel.</p></article><article><span class="transport-mark">03</span><h3>Taxis & ride-hailing</h3><p>Enter the monument name or its coordinates as the destination. This can help when a driver knows the city hall district better than the map address.</p></article><article><span class="transport-mark">04</span><h3>Private vehicle</h3><p>Follow road markings, staff directions, and temporary traffic measures when events are happening. Do not rely on roadside shoulders as parking; capacity can change quickly at night and on weekends.</p></article></div><div class="utility-strip" aria-label="Practical facilities around the monument"><div><span>↗</span><p><b>Parking</b>Look for official areas and follow on-site signs.</p></div><div><span>⌂</span><p><b>Toilets</b>Confirm availability when you arrive.</p></div><div><span>✦</span><p><b>Food & drink</b>Choose an appropriate type of venue nearby; no brand endorsements.</p></div><div><span>◫</span><p><b>Everyday supplies</b>Find a convenience store or market according to your needs.</p></div><div><span>ϟ</span><p><b>Fuel & charging</b>Plan before entering peak traffic periods.</p></div></div></div></section>

    <section class="neighborhood-section section wrap" aria-labelledby="nearby-title"><div class="section-head"><div><p class="section-label">05 / AROUND THE CITY</p><h2 id="nearby-title">Continue the day<br /><em>with Jambi in context.</em></h2></div><p class="section-lead">This is not a shopping list or a business recommendation. Use it as a set of categories and directions for building your own route.</p></div><div class="neighborhood-grid"><article><div class="neighborhood-no">01</div><div><h3>Heritage & museums</h3><p>To understand the keris and regional history, look for museums or cultural exhibition spaces run by public institutions. Check opening hours before travelling.</p></div></article><article><div class="neighborhood-no">02</div><div><h3>The Batanghari riverfront</h3><p>Public spaces along the river offer another way to read Jambi. Choose a safe area, follow local guidance, and be mindful of weather conditions.</p></div></article><article><div class="neighborhood-no">03</div><div><h3>Local food</h3><p>In central Jambi, look for Melayu-Jambi restaurants, coffee shops, or simple meals according to your dietary needs and schedule; this guide does not endorse individual businesses.</p></div></article><article><div class="neighborhood-no">04</div><div><h3>A longer regional trip</h3><p>If you have more time, research Jambi’s cultural and natural destinations separately. Distances and road conditions differ from a short visit in the city centre.</p></div></article></div></section>

    <section class="map-section" id="map" aria-labelledby="map-title"><div class="wrap map-layout"><div><p class="section-label">06 / LOCATION</p><h2 id="map-title">A point of<br /><em>orientation.</em></h2><p>Map address: 9J95+Q4F, Paal Lima, Kecamatan Kota Baru, Jambi City, Jambi 36129. Use the map to assess routing conditions from your current position.</p><a class="button button-ink" href="https://maps.app.goo.gl/oFEC5iTuxVTmAifd8" target="_blank" rel="noreferrer">Open in Google Maps <span>↗</span></a></div><div class="map-frame"><iframe title="Tugu Keris Siginjai map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2851.2226351513896!2d103.6067082705946!3d-1.6305741540278058!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e258620c925ab8d%3A0x8accc8e879b02a41!2sMonument%20of%20Keris%20Siginjai%20Jambi!5e1!3m2!1sen!2sid!4v1787019119814!5m2!1sen!2sid" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div></section>

    <section class="faq-section section wrap" id="faq" aria-labelledby="faq-title"><div class="faq-intro"><p class="section-label">07 / FAQ</p><h2 id="faq-title">Questions before<br /><em>you set out.</em></h2><p>These answers are for initial orientation. For event changes, access, or public services, check Jambi City’s official channels shortly before your journey.</p></div><div class="faq-list"><details><summary>Is there an admission ticket for Tugu Keris Siginjai?<span>+</span></summary><p>The monument is in a public open-air space and is generally viewed without a routine ticket booth. Check for event arrangements or area restrictions before visiting.</p></details><details><summary>When is a good time to visit?<span>+</span></summary><p>Morning and the period around sunset are often more comfortable for walking and photographs. The landmark’s night lighting is part of the visual experience, while weather and city activity affect conditions.</p></details><details><summary>How do I get there from the airport?<span>+</span></summary><p>Consider an airport taxi, rental vehicle, or ride-hailing service from Sultan Thaha Airport. For buses and local transport, confirm current routes and operating hours on the day you travel.</p></details><details><summary>Are parking, toilets, and food available?<span>+</span></summary><p>Parking and toilet availability can change with district arrangements. For food or supplies, use nearby venue categories as an orientation and choose independently according to your needs.</p></details></div></section>

    <section class="reference-section" aria-labelledby="sources-title"><div class="wrap reference-layout"><div><p class="section-label gold">08 / TRANSPARENCY</p><h2 id="sources-title">A guide that<br />acknowledges <em>its sources.</em></h2></div><div><p>Historical information refers to the National Museum of Indonesia, Jambi City Government, and the Indonesia tourism portal. Map scores, routes, and service conditions may change; use this site as a starting point rather than a substitute for a pre-travel confirmation.</p><ul><li><a href="https://museumnasional.iheritage-virtual.id/collection/detail/75" target="_blank" rel="noreferrer">National Museum of Indonesia — Keris Si Ginjei ↗</a></li><li><a href="https://jambikota.go.id/tentang/profil/arti_lambang" target="_blank" rel="noreferrer">Jambi City Government — Emblem meaning ↗</a></li><li><a href="https://www.indonesia.travel/us/en/destination/sumatra/jambi/tugu-keris-siginjai-jambi" target="_blank" rel="noreferrer">Wonderful Indonesia — Tugu Keris Siginjai ↗</a></li><li><a href="https://commons.wikimedia.org/wiki/File:Tugu_Keris_Siginjai.jpg" target="_blank" rel="noreferrer">Monument photo: Roby diery, CC BY-SA 4.0 ↗</a></li><li><a href="https://commons.wikimedia.org/wiki/File:Kantor_Gubernur_Jambi_-_Jambi_City,_JA_(25-11-2022).jpg" target="_blank" rel="noreferrer">City-context photo: Firzafp, CC BY-SA 4.0 ↗</a></li></ul></div></div></section>
  </main>

  <footer class="site-footer"><div class="wrap footer-grid"><div class="footer-brand"><img src="/icons/keris-mark.svg" width="40" height="40" alt="" /><p><b>Tugu Keris Siginjai</b><span>Independent Jambi City guide</span></p></div><div class="footer-note"><p>This website is an independent, non-profit visitor-information project. It is not affiliated with any government body, site operator, or official organisation.</p><p>Information refers to public material from Jambi City Government, the Jambi City Tourism and Culture Office, and the Indonesia tourism portal; it does not contain commercial recommendations.</p></div><div class="footer-links"><button type="button" data-dialog-open="privacy">Privacy Policy</button><button type="button" data-dialog-open="terms">Terms of Service</button><button type="button" data-dialog-open="cookies">Cookie Settings</button></div><div class="footer-bottom"><span>© 2026 Tugu Keris Siginjai Guide. Original content is protected.</span><span>Photographs remain the copyright of their respective photographers.</span></div></div></footer>
  <dialog class="policy-dialog" data-dialog="privacy"><div><button class="dialog-close" type="button" aria-label="Close" data-dialog-close>×</button><p class="section-label">PRIVACY POLICY</p><h2>Privacy, only as needed.</h2><p><b>Last updated: August 2026.</b> We collect only the minimum data needed to operate the site, including technical browsing data, cookies, and information you voluntarily provide where a contact method is available.</p><p>Data is used to improve content, understand aggregate usage patterns, respond to requests, and meet legal obligations. Google Maps and Google Analytics may apply as third-party services under their respective privacy policies.</p><p>You may request access, correction, deletion, object to processing, or contact the relevant data-protection authority in accordance with applicable law.</p></div></dialog>
  <dialog class="policy-dialog" data-dialog="terms"><div><button class="dialog-close" type="button" aria-label="Close" data-dialog-close>×</button><p class="section-label">TERMS OF SERVICE</p><h2>Information for orientation.</h2><p><b>Last updated: August 2026.</b> By using this site, you understand that its materials are provided for general information. We are an independent third-party visitor-information site and are not affiliated with an attraction operator, government body, or commercial operator.</p><p>We seek to keep information accurate, but access, events, place conditions, and services can change. Confirm important points through official channels before travelling. The site is provided as is, without warranty; travel decisions remain the user’s responsibility.</p><p>Original design and content are protected. Monument images use CC BY-SA 4.0 material with attribution; Google Maps is used under its terms.</p></div></dialog>
  <dialog class="policy-dialog" data-dialog="cookies"><div><button class="dialog-close" type="button" aria-label="Close" data-dialog-close>×</button><p class="section-label">COOKIE SETTINGS</p><h2>You are in control.</h2><p><b>Last updated: August 2026.</b> Essential storage keeps your consent preference. Analytics cookies are optional and load Google Analytics only after you agree.</p><div class="cookie-option"><div><b>Essential cookies</b><span>Needed to store preferences. Always active.</span></div><span class="always-on">Active</span></div><label class="cookie-option"><span><b>Analytics cookies</b><span>Help us understand anonymous site use with Google Analytics.</span></span><input type="checkbox" data-analytics-choice /></label><div class="dialog-actions"><button class="button button-ink" type="button" data-save-cookie>Save preferences</button><button class="text-link" type="button" data-reject-cookie>Reject analytics</button></div></div></dialog>
  <aside class="cookie-banner" data-cookie-banner aria-label="Cookie choices" hidden><p><b>Cookies, briefly.</b> We use essential storage for preferences and load analytics only if you agree.</p><div><button class="button button-gold" type="button" data-accept-cookie>Accept analytics</button><button class="text-link" type="button" data-reject-cookie>Reject</button></div></aside>
  <script is:inline>
    const consentKey = "tks-cookie-consent"; const banner = document.querySelector("[data-cookie-banner]"); const analyticsChoice = document.querySelector("[data-analytics-choice]");
    const loadAnalytics = () => { if (document.querySelector("script[data-ga4]")) return; const script = document.createElement("script"); script.async = true; script.src = "https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"; script.dataset.ga4 = "true"; document.head.appendChild(script); window.dataLayer = window.dataLayer || []; function gtag(){window.dataLayer.push(arguments);} gtag("js", new Date()); gtag("config", "G-HXM22WWPKP", { anonymize_ip: true }); };
    const applyConsent = (value) => { localStorage.setItem(consentKey, value); if (value === "accepted") loadAnalytics(); if (analyticsChoice) analyticsChoice.checked = value === "accepted"; if (banner) banner.hidden = true; };
    const saved = localStorage.getItem(consentKey); if (!saved && banner) banner.hidden = false; if (saved === "accepted") loadAnalytics(); if (analyticsChoice) analyticsChoice.checked = saved === "accepted";
    document.querySelectorAll("[data-accept-cookie]").forEach((button) => button.addEventListener("click", () => applyConsent("accepted"))); document.querySelectorAll("[data-reject-cookie]").forEach((button) => button.addEventListener("click", () => applyConsent("rejected")));
    document.querySelector("[data-save-cookie]")?.addEventListener("click", () => { applyConsent(analyticsChoice?.checked ? "accepted" : "rejected"); document.querySelector("[data-dialog='cookies']")?.close(); });
    document.querySelectorAll("[data-dialog-open]").forEach((button) => button.addEventListener("click", () => document.querySelector(`[data-dialog='${button.dataset.dialogOpen}']`)?.showModal())); document.querySelectorAll("[data-dialog-close]").forEach((button) => button.addEventListener("click", () => button.closest("dialog")?.close())); document.querySelectorAll("dialog").forEach((dialog) => dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); }));
    const menuButton = document.querySelector("[data-menu-button]"); const mainNav = document.querySelector("[data-main-nav]"); menuButton?.addEventListener("click", () => { const open = menuButton.getAttribute("aria-expanded") === "true"; menuButton.setAttribute("aria-expanded", String(!open)); mainNav?.classList.toggle("is-open", !open); }); mainNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { menuButton?.setAttribute("aria-expanded", "false"); mainNav?.classList.remove("is-open"); }));
  </script>
</BaseLayout>
