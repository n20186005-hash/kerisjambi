---
import TopicPage from "../../components/TopicPage.astro";
import { getTopic, topicSlugs } from "../../data/topics";

export function getStaticPaths() {
  return topicSlugs().map((slug) => ({ params: { topic: slug } }));
}

const { topic } = Astro.params as { topic: string };
const t = getTopic(topic);
if (!t || !t.en) return Astro.redirect("/en/404/");
---
<TopicPage topic={t} content={t.en} lang="en" />
