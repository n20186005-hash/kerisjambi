---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "Terms of Service — Tugu Keris Siginjai Guide";
const description = "Terms of service for the independent visitor guide to Tugu Keris Siginjai, Jambi City.";
---
<BaseLayout {title} {description} lang="en">
  <a class="skip-link" href="#isi">Skip to content</a>
  <header class="legal-header">
    <a class="brand" href="/en/"><img src="/icons/keris-mark.svg" width="40" height="40" alt="" /><span><strong>Tugu Keris</strong><small>Jambi City guide</small></span></a>
    <div class="language-switch" aria-label="Choose language"><a href="/syarat-layanan/" lang="id">ID</a><span aria-hidden="true">/</span><a href="/en/terms-of-service/" lang="en" aria-current="page">EN</a></div>
  </header>

  <main id="isi">
    <section class="legal-hero"><div class="wrap">
      <p class="eyebrow"><span class="eyebrow-dot"></span> LEGAL · TERMS OF SERVICE</p>
      <h1>Information for <em>orientation.</em></h1>
      <p class="legal-lead">Last updated: August 2026. By using this site, you understand that its materials are provided for general information.</p>
    </div></section>

    <section class="legal-body section wrap">
      <h2>Nature of the information</h2>
      <p>All material on this site is provided for general information and visitor orientation. This site is not a substitute for official confirmation from the government or the site operator before your journey.</p>

      <h2>Independent status</h2>
      <p>We are an independent third-party visitor-information site and are not affiliated with an attraction operator, government body, or commercial operator. References and external links are provided as sources.</p>

      <h2>Accuracy and changes</h2>
      <p>We seek to keep information accurate, but access, events, place conditions, and services can change. Confirm important points through official channels before travelling.</p>

      <h2>Intellectual property</h2>
      <p>Original design and content are protected. Monument images use CC BY-SA 4.0 material with attribution; Google Maps is used under its terms. Third-party names, marks, and emblems remain the property of their owners.</p>

      <h2>Third-party services</h2>
      <p>Maps and analytics may be provided by third-party services. Your use of those services is subject to each provider’s own terms and policies.</p>

      <h2>Limitation of liability</h2>
      <p>The site is provided as is, without warranty. Travel decisions remain the user’s responsibility, including safety, transport, and the fit between the information and current conditions.</p>

      <h2>Governing law</h2>
      <p>These terms are governed by the laws applicable in the Republic of Indonesia, unless another binding legal framework takes precedence.</p>

      <h2>Changes to these terms</h2>
      <p>These terms may be updated from time to time. Continued use of the site after an update means you accept the latest terms.</p>

      <a class="legal-back" href="/en/">← Back to home</a>
    </section>
  </main>

  <footer class="site-footer"><div class="wrap footer-grid"><div class="footer-brand"><img src="/icons/keris-mark.svg" width="40" height="40" alt="" /><p><b>Tugu Keris Siginjai</b><span>Independent Jambi City guide</span></p></div><div class="footer-note"><p>This website is an independent, non-profit visitor-information project. It is not affiliated with any government body, site operator, or official organisation.</p><p>Information refers to public material from Jambi City Government, the Jambi City Tourism and Culture Office, and the Indonesia tourism portal; it does not contain commercial recommendations.</p></div><div class="footer-links"><a href="/en/privacy-policy/">Privacy Policy</a><a href="/en/terms-of-service/">Terms of Service</a><a href="/en/cookie-settings/">Cookie Settings</a></div><div class="footer-bottom"><span>© 2026 Tugu Keris Siginjai Guide. Original content is protected.</span><span>Photographs remain the copyright of their respective photographers.</span></div></div></footer>
</BaseLayout>
